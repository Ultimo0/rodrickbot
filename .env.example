# Copie ce fichier en .env puis remplis les valeurs. Voir README.md pour le
# détail de chaque variable.
#
# Ce fichier ne contient PLUS aucune clé API ni secret d'infrastructure :
# GROQ_API_KEY, OPENWEATHER_API_KEY, REMOVE_BG_API_KEY, CHANNEL_JID,
# TELEMETRY_URL et TELEMETRY_API_KEY vivent maintenant dans
# src/config/settings.json (voir settings.example.json pour le modèle).
# - Les clés Groq/OpenWeather/Remove.bg se configurent directement depuis
#   WhatsApp en message privé : !groqapi <clé>, !meteoapi <clé>,
#   !removeapi <clé> (voir README.md, section "Clés API").
# - CHANNEL_JID / TELEMETRY_URL / TELEMETRY_API_KEY s'éditent uniquement à
#   la main dans settings.json (volontairement non modifiables depuis
#   WhatsApp).
#
# Si tu mets à jour une installation existante qui avait déjà l'une de ces
# variables dans son .env, elle est importée automatiquement (une seule
# fois) dans settings.json au premier démarrage après la mise à jour — tu
# peux ensuite supprimer la ligne correspondante de ton .env.

# Requis seulement si src/config/settings.json a "authMethod": "code".
# Format international sans "+" (ex: 237638838029). Reste en .env (et non
# dans settings.json) car nécessaire avant même la première connexion
# WhatsApp, donc avant qu'aucune commande ne puisse le configurer.
PHONE_NUMBER=

# Optionnel — true pour écrire aussi les logs dans data/logs/bot.log (rotation automatique).
LOG_TO_FILE=

# Legacy, optionnel — NE PAS configurer pour une nouvelle installation.
# Le propriétaire est détecté automatiquement ; les admins supplémentaires
# s'ajoutent avec {prefix}addadmin directement dans WhatsApp. Si renseigné,
# cette valeur est importée une seule fois dans data/admins.json au premier
# démarrage, puis ignorée ensuite.
ADMIN_JIDS=
