# Copie ce fichier en .env puis remplis les valeurs. Voir README.md pour le
# détail de chaque variable (laquelle est requise, laquelle est optionnelle).

# Requis pour les fonctionnalités IA (!ia, !corriger, !resume, !ocr, agent).
GROQ_API_KEY=

# Requis seulement si src/config/settings.json a "authMethod": "code".
# Format international sans "+" (ex: 237638838029).
PHONE_NUMBER=

# Optionnel — pour la commande !meteo.
OPENWEATHER_API_KEY=

# Optionnel — JID (xxxx@newsletter) de la chaîne WhatsApp officielle du bot.
CHANNEL_JID=

# Optionnel — dashboard-server de suivi d'instance (projet séparé).
TELEMETRY_URL=
TELEMETRY_API_KEY=

# Optionnel — true pour écrire aussi les logs dans data/logs/bot.log (rotation automatique).
LOG_TO_FILE=

# Legacy, optionnel — NE PAS configurer pour une nouvelle installation.
# Le propriétaire est détecté automatiquement ; les admins supplémentaires
# s'ajoutent avec {prefix}addadmin directement dans WhatsApp. Si renseigné,
# cette valeur est importée une seule fois dans data/admins.json au premier
# démarrage, puis ignorée ensuite.
ADMIN_JIDS=
