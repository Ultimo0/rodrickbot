    "pdf-parse": "^1.1.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "youtube-dl-exec": "^3.0.10"
